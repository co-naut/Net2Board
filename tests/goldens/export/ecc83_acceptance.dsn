		)
		(net "unconnected-(P6-Pad1)"
			(pins P6-1)
		)
		(net "unconnected-(P7-Pad1)"
			(pins P7-1)
		)
		(net "unconnected-(P8-Pad1)"
			(pins P8-1)
		)
		(class DEFAULT GND "Net-(P1-PM)" "Net-(P2-P1)" "Net-(P3-P1)" "Net-(P4-P1)" "Net-(P4-PM)" "Net-(U1A-G)" "Net-(U1A-K)" "Net-(U1B-K)" "unconnected-(P5-Pad1)" "unconnected-(P6-Pad1)" "unconnected-(P7-Pad1)" "unconnected-(P8-Pad1)"
			(circuit
				(use_via Via_800)
			)
			(rule
				(width 250)
				(clearance 250)
			)
		)
	)
)
