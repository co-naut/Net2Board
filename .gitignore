# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environment
.venv/

# Caches
.pytest_cache/
.ruff_cache/

# Coverage
.coverage
htmlcov/

# OS
.DS_Store

# KiCad editor sidecars (project-local GUI state, not engine output)
*.kicad_prl

# Agent session plumbing (plans, scratch)
.opencode/

# Prototype scratch output
prototype_*.txt
prototype_*.kicad_pcb

# KiCad demo project — commit only the ecc83 fixture subset (see kicad_demo/ecc83/README.md)
kicad_demo/*
!kicad_demo/ecc83/
kicad_demo/ecc83/*
!kicad_demo/ecc83/README.md
!kicad_demo/ecc83/ecc83-pp.net
!kicad_demo/ecc83/footprints.pretty/
kicad_demo/ecc83/footprints.pretty/*
!kicad_demo/ecc83/footprints.pretty/*.kicad_mod
# tiny_tapeout hard-placement fixture (#30; see its README.md)
!kicad_demo/tiny_tapeout/
kicad_demo/tiny_tapeout/*
!kicad_demo/tiny_tapeout/README.md
!kicad_demo/tiny_tapeout/tinytapeout.net
!kicad_demo/tiny_tapeout/footprints.pretty/
kicad_demo/tiny_tapeout/footprints.pretty/*
!kicad_demo/tiny_tapeout/footprints.pretty/*.kicad_mod
